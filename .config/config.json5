{
  "keybindings": {
    "<q>": "Quit", // Quit the application
    "<Ctrl-d>": "Quit", // Another way to quit
    "<Ctrl-c>": "Quit", // Yet another way to quit
    "<Ctrl-z>": "Suspend", // Suspend the application,
    "<F8>": "SwitchModeHome", // Change mode to Home
    "<F9>": "SwitchModeConfig", // Change mode to Config,
    "Home": { 
        // custom keybindings 
    },
    "Config": { 
        // custom keybindings 
    },
  }
}
