{
  "keybindings": {
    "<q>": "Quit", // Quit the application
    "<Ctrl-d>": "Quit", // Another way to quit
    "<Ctrl-c>": "Quit", // Yet another way to quit
    "<Ctrl-z>": "Suspend", // Suspend the application,
    "<F1": "SwitchModeHome", // Change mode to Home
    "<F2>": "SwitchModeConfig", // Change mode to Config,
    "<Ctrl-q>": "ClosePopup",
    "Home": { 
        // custom keybindings 
    },
    "Config": { 
        // custom keybindings 
    },
  }
}
